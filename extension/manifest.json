{
  "manifest_version": 3,
  "name": "Catanalytics Uploader",
  "version": "1.0.0",
  "description": "Capture the current Colonist.io game log and upload it to Catanalytics.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://colonist.io/*",
    "https://api.catanalytics.meekconsulting.com/*"
  ]
}
